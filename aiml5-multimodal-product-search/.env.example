# ---------------------------------------------------------------------------
# Multimodal Product Search - example configuration
#
# Copy to .env and edit. Never commit a real .env: it is git-ignored.
#   cp .env.example .env
#
# Every value below is a default that already works. The two profiles are:
#   * local, no containers -> SQLite + embedded Qdrant (leave as-is)
#   * docker compose       -> PostgreSQL + Qdrant server (see the block below)
# ---------------------------------------------------------------------------

# ------------------------------- application -------------------------------
APP_ENV=local
LOG_LEVEL=INFO
# console = human readable, json = one object per line for log shippers
LOG_FORMAT=console
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000

# --------------------------------- database --------------------------------
# Default: SQLite, so the project runs with no container runtime.
DATABASE_URL=sqlite+aiosqlite:///./data/local/catalog.db
# PostgreSQL (what docker compose provisions):
# DATABASE_URL=postgresql+asyncpg://mps:mps@localhost:5432/mps
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ---------------------------------- qdrant ---------------------------------
# Leave QDRANT_URL unset to run Qdrant embedded, persisting to QDRANT_PATH.
# Set it to use a Qdrant server (docker compose sets it automatically).
# QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_PATH=./data/local/qdrant
QDRANT_COLLECTION=products
QDRANT_TIMEOUT=30
QDRANT_HNSW_M=16
QDRANT_HNSW_EF_CONSTRUCT=128

# ----------------------------------- model ---------------------------------
# Any dual-encoder exposing get_image_features/get_text_features works.
# The embedding dimension is read from the model, never configured.
#   openai/clip-vit-base-patch32          512-d, ~605 MB   (default, CPU friendly)
#   laion/CLIP-ViT-B-32-laion2B-s34B-b79K 512-d, ~605 MB   (stronger zero-shot)
#   google/siglip-base-patch16-224        768-d, ~810 MB   (stronger, slower)
# Changing this invalidates every stored embedding; re-run:
#   python scripts/index_catalog.py --force --recreate
MODEL_NAME=openai/clip-vit-base-patch32
# auto picks cuda > mps > cpu
MODEL_DEVICE=auto
# MODEL_CACHE_DIR=./data/local/models
# 0 leaves torch's thread default alone
TORCH_NUM_THREADS=0
EMBEDDING_BATCH_SIZE=32
# Caps concurrent forward passes so a burst of requests cannot thrash the CPU
MAX_CONCURRENT_INFERENCES=2

# ------------------------------ ranking / fusion ---------------------------
# Every default in this block is the MEASURED optimum from
#   python scripts/run_experiments.py
# on the benchmark query set, not a guess. Results: evaluation/results/experiments.md
#
# weighted_sum      normalise each channel, then weight and add   (default)
# rrf               reciprocal rank fusion; ignores score magnitudes
# embedding_fusion  blend image+text into one query vector before retrieval
# Measured at a matched image share: weighted_sum nDCG@10 0.597,
# rrf 0.575, embedding_fusion 0.574 (but embedding_fusion had the best MRR, 0.832).
FUSION_STRATEGY=weighted_sum

# Per-channel normalisation before the weighted sum. Same-modality cosines
# (image-image 0.7305 mean) and cross-modal cosines (image-text 0.3124 mean) are
# not on the same scale, so without this the weights below do not mean what they
# say. Measure for your own model with scripts/verify_embedding_space.py.
# Measured: zscore 0.668, none 0.655, minmax 0.646 (nDCG@10). The effect is real
# but modest; the main benefit is that the weights stay interpretable.
# Options: zscore | minmax | none
SCORE_NORMALIZATION=zscore

# Modality weights. These apply ONLY when a query carries both an image and text;
# a single-modality query always gives that modality the full weight.
# 0.2/0.8 maximises mean nDCG@10 across both multimodal query styles. The two
# styles genuinely disagree, so no single value is optimal for both:
#   "this, but in black" (text contradicts image) peaks at IMAGE_WEIGHT=0.1 -> 0.429
#   photo + "black handbag" (they agree)          peaks at IMAGE_WEIGHT=0.5 -> 0.831
# At each group's own optimum, fusion beats BOTH single modalities. Clients can
# override per request via the "fusion" field on any search call.
IMAGE_WEIGHT=0.2
TEXT_WEIGHT=0.8

# Lexical keyword channel (Postgres full-text search; LIKE-based on SQLite).
# Measured OFF by default. Under minmax normalisation it gave a small gain, but
# with zscore it was neutral-to-negative (nDCG@10 0.677 off vs 0.669 at 0.2) and
# roughly tripled median latency, because the SQLite fallback scores candidates in
# Python. Re-measure before enabling on PostgreSQL, where this channel becomes
# real full-text search with stemming and term weighting.
LEXICAL_WEIGHT=0.0

# Within one modality, the share given to the CROSS-modal channel, e.g. a text
# query scored against a product's image vector. The rest goes to the
# same-modality channel. 0 = ignore the other modality's vector entirely.
# Measured sweep on single-modality queries: 0.3 is best (nDCG@10 0.717).
# Notably the cross-modal channel is strong on its own - for image queries,
# image->text (0.818) slightly beat image->image (0.796).
CROSS_MODAL_WEIGHT=0.3

# alpha for FUSION_STRATEGY=embedding_fusion: alpha*image + (1-alpha)*text
EMBEDDING_FUSION_ALPHA=0.5

# Rank constant for FUSION_STRATEGY=rrf
RRF_K=60

# Candidate pool per channel = top_k * CANDIDATE_MULTIPLIER (at least
# MIN_CANDIDATE_POOL). Fusion can only reorder what retrieval surfaced, so the
# pool must exceed top_k for fusion to change anything.
# Measured depth/latency trade-off: top_k 20 -> nDCG@10 0.646 at 33ms median;
# top_k 100 -> 0.670 at 63ms. Deeper retrieval helps a little and costs ~2x.
CANDIDATE_MULTIPLIER=4
MIN_CANDIDATE_POOL=50
DEFAULT_TOP_K=20
MAX_TOP_K=100

# -------------------------------- image input ------------------------------
MAX_UPLOAD_BYTES=10485760
ALLOWED_IMAGE_FORMATS=JPEG,PNG,WEBP
MAX_IMAGE_DIMENSION=1024
MIN_IMAGE_DIMENSION=8

# ---------------------------------- caching --------------------------------
# In-process LRU cache of text-query embeddings. 0 disables.
TEXT_EMBEDDING_CACHE_SIZE=512

# --------------------------------- ingestion -------------------------------
INGEST_BATCH_SIZE=64
# Root for image paths stored in image_url. Also the path-traversal boundary
# for resolving catalogue images.
IMAGE_ROOT=./data
