{
  "$schema_note": "Relevance is a predicate over product attributes, resolved against the live catalogue at evaluation time. See docs/evaluation.md for the methodology and its limitations.",
  "version": "1.0",
  "catalogue": {
    "built_with": "python scripts/download_dataset.py --limit 6000 --out data/eval",
    "note": "Queries were written against a 6,000-product stratified sample. They also run on the 1,000-product data/sample catalogue, where smaller relevant sets make the numbers noisier; queries with fewer than 2 relevant products are reported as skipped rather than scored."
  },
  "relevance_policy": {
    "text": "Article type AND the attribute the query names (colour / gender / usage).",
    "image": "Same article type as the query product, which is what visual similarity should recover. Colour is deliberately NOT required, so this measures category recognition rather than colour fidelity.",
    "multimodal": "Same article type as the query image AND the colour named in the text. The query image is always a DIFFERENT colour from the target, so the text must do real work: a system ignoring the text scores near zero.",
    "multimodal_groups": {
      "contradiction": "Text names an attribute the query image does NOT have (white shoe + 'but in black'); relevance requires the attribute from the TEXT. A system ignoring the text scores near zero. Favours text-heavy weighting.",
      "agreement": "Text reinforces what the image already shows; relevance requires the shared attributes. Favours image-heavy weighting. Both groups are reported separately because a single average over them would make any recommended weight an artefact of the query mix."
    }
  },
